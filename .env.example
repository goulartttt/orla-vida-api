# Copie para .env e preencha. Nunca faça commit do .env.
# Para gerar os três segredos abaixo: npm run gerar-segredos

NODE_ENV=development
PORT=3001

# String de conexão do MongoDB Atlas. O nome do banco vai antes do "?":
# orla-vida-dev (local), orla-vida-hml (homologação), orla-vida-prd (produção)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/orla-vida-dev?appName=orla-vida

# Assinatura dos tokens de sessão (mínimo 32 caracteres)
JWT_SECRET=

# Criptografia do CPF (AES-256-GCM): 32 bytes em base64
CPF_CHAVE_CRIPTOGRAFIA=

# Hash de busca do CPF (HMAC-SHA256): mínimo 32 caracteres
CPF_CHAVE_HMAC=

# Origens que podem chamar a API direto do navegador (separadas por vírgula)
ORIGENS_PERMITIDAS=http://localhost:5173

# Segredo compartilhado com o proxy do site (mesmo valor no projeto orla-vida da Vercel).
# Permite que a API saiba o IP real do visitante para o limite de tentativas.
# Opcional em desenvolvimento. Mínimo 32 caracteres.
PROXY_SECRET=
