{
  "name": "orla-vida-api",
  "version": "1.0.0",
  "private": true,
  "description": "API da Orla Vida, seguradora de vida fictícia (projeto de portfólio).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/local.js",
    "start": "node --env-file-if-exists=.env src/local.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test",
    "format": "prettier --write .",
    "gerar-segredos": "node scripts/gerar-segredos.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "mongodb-memory-server@11.3.0": true
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  }
}
